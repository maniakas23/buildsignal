    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@planetscale/database": "^1.20.1",
    "cookie": "^1.1.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.8.3",
    "jose": "6.1.3",
    "stripe": "^22.4.0",
    "superjson": "^2.2.6",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "~5.9.3"
  }
}

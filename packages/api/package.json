{
  "name": "@buildsignal/api",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "./src/app.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src/ --ext .ts",
